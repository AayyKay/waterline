<UserControl x:Class="Waterline.ReservoirGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Width="210" MinHeight="145" Focusable="False" IsHitTestVisible="False"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             automation:AutomationProperties.Name="{Binding ProgressLabel}">
  <UserControl.Resources>
    <Style x:Key="ReservoirScaleLabel" TargetType="TextBlock" BasedOn="{StaticResource MetadataText}">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="126" />
      <ColumnDefinition Width="20" />
      <ColumnDefinition Width="64" />
    </Grid.ColumnDefinitions>

    <Border x:Name="ReservoirBody" Grid.Column="0" Width="112" Margin="7,10"
            CornerRadius="30" BorderBrush="{DynamicResource BoundaryBrush}" BorderThickness="2"
            Background="{DynamicResource CanvasRaisedBrush}" ClipToBounds="True">
      <Grid ClipToBounds="True">
        <Rectangle Fill="{DynamicResource CanvasRaisedBrush}" />

        <Grid x:Name="ReservoirFill" Height="0" VerticalAlignment="Bottom" ClipToBounds="True">
          <Border Background="{DynamicResource ReservoirBrush}" CornerRadius="0,0,27,27" />

          <Canvas x:Name="CausticLayer" Opacity=".28" ClipToBounds="True">
            <Canvas.RenderTransform><TranslateTransform x:Name="CausticTranslate" /></Canvas.RenderTransform>
            <Path Data="M-18,42 C8,8 35,72 63,35 S108,20 138,58" Stroke="{DynamicResource AquaBrush}" StrokeThickness="2" Opacity=".65" />
            <Path Data="M-28,105 C4,70 31,132 66,92 S111,68 145,112" Stroke="{DynamicResource CyanBrush}" StrokeThickness="1.5" Opacity=".48" />
            <Path Data="M-12,174 C18,138 48,202 78,162 S119,145 142,184" Stroke="{DynamicResource FocusBrush}" StrokeThickness="1.4" Opacity=".34" />
          </Canvas>

          <Ellipse Width="4" Height="4" Stroke="{DynamicResource AquaBrush}" StrokeThickness="1"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="69,0,0,42">
            <Ellipse.RenderTransform><TranslateTransform x:Name="BubbleOneTranslate" /></Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse Width="3" Height="3" Stroke="{DynamicResource FocusBrush}" StrokeThickness="1"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="52,0,0,77">
            <Ellipse.RenderTransform><TranslateTransform x:Name="BubbleTwoTranslate" /></Ellipse.RenderTransform>
          </Ellipse>
          <Ellipse Width="2.5" Height="2.5" Fill="{DynamicResource AquaBrush}" Opacity=".75"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="76,0,0,108">
            <Ellipse.RenderTransform><TranslateTransform x:Name="BubbleThreeTranslate" /></Ellipse.RenderTransform>
          </Ellipse>

          <Rectangle x:Name="ReservoirHighlight" Opacity="0" Height="70" VerticalAlignment="Bottom">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                <GradientStop Color="#0068F2D0" />
                <GradientStop Color="#8A68F2D0" Offset=".5" />
                <GradientStop Color="#0068F2D0" Offset="1" />
              </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.RenderTransform><TranslateTransform x:Name="ReservoirHighlightTranslate" /></Rectangle.RenderTransform>
          </Rectangle>

          <Grid Height="22" VerticalAlignment="Top" ClipToBounds="False">
            <Path Data="M-6,12 C19,1 37,19 60,11 C82,3 93,2 118,10"
                  Stroke="{DynamicResource FocusBrush}" StrokeThickness="4" Opacity=".2" Stretch="Fill">
              <Path.RenderTransform><TranslateTransform x:Name="WaveGlowTranslate" /></Path.RenderTransform>
            </Path>
            <Path x:Name="ReservoirSurface" Data="M-6,10 C19,1 37,18 60,10 C82,2 94,3 118,9"
                  Stroke="{DynamicResource AquaBrush}" StrokeThickness="1.8" Stretch="Fill"
                  RenderTransformOrigin=".5,.5">
              <Path.RenderTransform>
                <TransformGroup>
                  <TranslateTransform x:Name="WaveTranslate" />
                  <ScaleTransform x:Name="ReservoirSurfaceScale" ScaleY="1" />
                </TransformGroup>
              </Path.RenderTransform>
            </Path>
            <Path Data="M-10,14 C14,7 34,17 55,13 C78,8 94,6 122,12"
                  Stroke="{DynamicResource CyanBrush}" StrokeThickness="1" Opacity=".7" Stretch="Fill">
              <Path.RenderTransform><TranslateTransform x:Name="SecondWaveTranslate" /></Path.RenderTransform>
            </Path>
          </Grid>
        </Grid>

        <Border Margin="4" CornerRadius="26" BorderBrush="{DynamicResource TextPrimaryBrush}"
                BorderThickness="1" Opacity=".16" />
        <Border Width="7" HorizontalAlignment="Left" Margin="8,16,0,18" CornerRadius="4" Opacity=".42">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#00FFFFFF" />
              <GradientStop Color="#B8FFFFFF" Offset=".52" />
              <GradientStop Color="#00FFFFFF" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
        </Border>
        <Border Height="26" VerticalAlignment="Top" Margin="5,5,5,0" CornerRadius="25,25,14,14"
                BorderBrush="{DynamicResource FocusBrush}" BorderThickness="1" Opacity=".5" />
        <Border Width="5" HorizontalAlignment="Right" Margin="0,18,8,22" CornerRadius="3"
                Background="{DynamicResource CyanBrush}" Opacity=".12" />
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="0,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" />
        <RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" />
        <RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Width="15" Height="1" Background="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
      <Border Grid.Row="1" Width="8" Height="1" Background="{DynamicResource BoundaryBrush}" HorizontalAlignment="Left" />
      <Border Grid.Row="2" Width="13" Height="1" Background="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left" />
      <Border Grid.Row="3" Width="8" Height="1" Background="{DynamicResource BoundaryBrush}" HorizontalAlignment="Left" />
      <Border Grid.Row="4" Width="13" Height="1" Background="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left" />
      <Border Grid.Row="5" Width="8" Height="1" Background="{DynamicResource BoundaryBrush}" HorizontalAlignment="Left" />
      <Border Grid.Row="6" Width="13" Height="1" Background="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left" />
      <Border Grid.Row="7" Width="8" Height="1" Background="{DynamicResource BoundaryBrush}" HorizontalAlignment="Left" />
      <Border Grid.Row="8" Width="15" Height="1" Background="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
    </Grid>

    <Grid Grid.Column="2" Margin="5,8,0,8">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" /><RowDefinition Height="*" /><RowDefinition Height="*" />
        <RowDefinition Height="*" /><RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="{Binding ReservoirGoalLabel}" Style="{StaticResource ReservoirScaleLabel}" VerticalAlignment="Top" />
      <TextBlock Grid.Row="1" Text="{Binding ReservoirThreeQuarterLabel}" Style="{StaticResource ReservoirScaleLabel}" />
      <TextBlock Grid.Row="2" Text="{Binding ReservoirHalfLabel}" Style="{StaticResource ReservoirScaleLabel}" />
      <TextBlock Grid.Row="3" Text="{Binding ReservoirQuarterLabel}" Style="{StaticResource ReservoirScaleLabel}" />
      <TextBlock Grid.Row="4" Text="0" Style="{StaticResource ReservoirScaleLabel}" VerticalAlignment="Bottom" Margin="0,0,0,1" />
    </Grid>
  </Grid>
</UserControl>

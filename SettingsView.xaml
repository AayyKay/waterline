<UserControl x:Class="Waterline.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,7" /></Style>
    <Style x:Key="SettingsNotice" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="14,10" /><Setter Property="Margin" Value="0,0,0,14" /><Setter Property="Visibility" Value="Collapsed" /></Style>
  </UserControl.Resources>
  <StackPanel>
    <StackPanel Margin="0,0,0,22"><TextBlock Text="SETTINGS" Style="{StaticResource MetadataText}" Foreground="{DynamicResource CyanBrush}" /><TextBlock Text="Waterline on this PC" Style="{StaticResource PageTitleText}" Margin="0,5,0,0" /><TextBlock Text="Manage local preferences, updates, data health, and privacy." Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,4,0,0" /></StackPanel>

    <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource SettingsNotice}"><Style.Triggers><DataTrigger Binding="{Binding Configuration.HasSettingsError}" Value="True"><Setter Property="Visibility" Value="Visible" /><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Configuration.SettingsError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Assertive" /></Border>
    <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource SettingsNotice}"><Style.Triggers><DataTrigger Binding="{Binding Configuration.HasSettingsNotice}" Value="True"><Setter Property="Visibility" Value="Visible" /><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Configuration.SettingsNotice}" Foreground="{DynamicResource SuccessBrush}" automation:AutomationProperties.LiveSetting="Polite" /></Border>

    <Grid x:Name="SettingsColumns"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="390" /></Grid.ColumnDefinitions>
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Preferences" Style="{StaticResource SectionTitleText}" /><TextBlock Text="Changes remain a draft until saved." Style="{StaticResource SecondaryText}" Margin="0,3,0,18" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Daily goal" Style="{StaticResource FieldLabel}" /><Grid><TextBox Text="{Binding Configuration.GoalText, UpdateSourceTrigger=PropertyChanged}" Padding="12,8,44,8" automation:AutomationProperties.Name="Daily goal in ounces" /><TextBlock Text="oz" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" Style="{StaticResource SecondaryText}" IsHitTestVisible="False" /></Grid></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Widget default" Style="{StaticResource FieldLabel}" /><ComboBox ItemsSource="{Binding Configuration.WidgetModes}" SelectedItem="{Binding Configuration.WidgetMode, Mode=TwoWay}" automation:AutomationProperties.Name="Widget default mode" /></StackPanel></Grid>
          <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Waterline sounds" FontWeight="SemiBold" /><TextBlock Text="Controls both logging and reminder sounds." Style="{StaticResource SecondaryText}" Margin="0,3,0,0" /></StackPanel><ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" IsChecked="{Binding Configuration.SoundsEnabled, Mode=TwoWay}" automation:AutomationProperties.Name="Waterline sounds enabled" /></Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button Style="{StaticResource QuietButton}" Content="Cancel" Click="Cancel_Click" IsEnabled="{Binding Configuration.HasSettingsChanges}" Margin="0,0,8,0" /><Button Style="{StaticResource PrimaryButton}" Content="Save settings" Click="Save_Click" IsEnabled="{Binding Configuration.HasSettingsChanges}" /></StackPanel>
        </StackPanel></Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Updates" Style="{StaticResource SectionTitleText}" /><TextBlock Text="{Binding Configuration.VersionLabel}" Style="{StaticResource SecondaryText}" Margin="0,3,0,0" /></StackPanel><Border Grid.Column="1" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BoundaryBrush}" BorderThickness="1" CornerRadius="12" Padding="9,4"><TextBlock Text="{Binding Configuration.UpdateState}" Style="{StaticResource MetadataText}" Foreground="{DynamicResource AquaBrush}" /></Border></Grid>
          <TextBlock Text="{Binding Configuration.UpdateStatus}" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,0" /><TextBlock Text="{Binding Configuration.UpdateDetail}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,0" />
          <ProgressBar Value="{Binding Configuration.UpdateProgress, Mode=OneWay}" Maximum="100" Margin="0,14,0,0"><ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Configuration.IsDownloading}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
          <WrapPanel Margin="0,18,0,0"><Button Content="Check again" Click="CheckUpdate_Click" IsEnabled="{Binding Configuration.CanCheckForUpdates}" Margin="0,0,8,8" /><Button Content="View release" Click="OpenRelease_Click" IsEnabled="{Binding Configuration.CanOpenRelease}" Margin="0,0,8,8" /><Button Content="Download update" Click="DownloadUpdate_Click" IsEnabled="{Binding Configuration.CanDownloadUpdate}" Margin="0,0,8,8" /><Button Style="{StaticResource PrimaryButton}" Content="Install update" Click="InstallUpdate_Click" IsEnabled="{Binding Configuration.CanInstallUpdate}" Margin="0,0,0,8" /></WrapPanel>
        </StackPanel></Border>
      </StackPanel>

      <StackPanel Grid.Column="2" x:Name="SettingsRail">
        <Border Style="{StaticResource Card}" Background="{DynamicResource ActivityRailBrush}" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Local data" Style="{StaticResource SectionTitleText}" />
            <TextBlock Text="{Binding Configuration.RecoveryStatus}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" />
            <TextBox Text="{Binding Configuration.DataLocation, Mode=OneWay}" ToolTip="{Binding Configuration.DataLocation}" IsReadOnly="True" Margin="0,12,0,0" automation:AutomationProperties.Name="Waterline local data path" />
            <WrapPanel Margin="0,12,0,0"><Button Content="Show in folder" Click="OpenData_Click" Margin="0,0,8,8" /><Button Content="Restore recovered data" Click="Recover_Click" IsEnabled="{Binding CanAcknowledgeRecovery}" Margin="0,0,0,8" /></WrapPanel>
            <Border BorderBrush="{DynamicResource BoundaryBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,14,0,0">
              <StackPanel>
                <TextBlock Text="Older Waterline data" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Configuration.LegacyImportStatus}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" automation:AutomationProperties.LiveSetting="Polite" />
                <Button Content="Import older data" Click="ImportLegacy_Click" IsEnabled="{Binding Configuration.CanImportLegacy}" HorizontalAlignment="Left" Margin="0,10,0,0" ToolTip="Merge valid Electron-era Waterline entries and settings" automation:AutomationProperties.Name="Import older Waterline data" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Background="{DynamicResource ActivityRailBrush}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Privacy" Style="{StaticResource SectionTitleText}" /><TextBlock Text="Hydration entries, preferences, schedules, widget placement, and diagnostics stay on this PC. Waterline has no analytics or telemetry. Network access is limited to update checks and downloads from the official GitHub repository." Style="{StaticResource SecondaryText}" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" /></StackPanel></Border>
        <Border Style="{StaticResource Card}" Background="{DynamicResource ActivityRailBrush}"><StackPanel><TextBlock Text="About &amp; diagnostics" Style="{StaticResource SectionTitleText}" /><TextBlock Text="{Binding Configuration.VersionLabel}" FontWeight="SemiBold" Margin="0,10,0,0" /><TextBlock Text="{Binding Configuration.DiagnosticsStatus}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,0" /><TextBlock Text="{Binding Configuration.DiagnosticsPath}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,0" /><Button Content="Clear diagnostics" Click="ClearDiagnostics_Click" HorizontalAlignment="Left" Margin="0,12,0,0" /></StackPanel></Border>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>

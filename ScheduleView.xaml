<UserControl x:Class="Waterline.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,7" /></Style>
    <Style x:Key="PhaseNotice" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Padding" Value="14,10" /><Setter Property="Margin" Value="0,0,0,14" /><Setter Property="Visibility" Value="Collapsed" /></Style>
  </UserControl.Resources>
  <StackPanel>
    <StackPanel Margin="0,0,0,22"><TextBlock Text="SCHEDULE" Style="{StaticResource MetadataText}" Foreground="{DynamicResource CyanBrush}" /><TextBlock Text="Plan gentle reminders" Style="{StaticResource PageTitleText}" Margin="0,5,0,0" /><TextBlock Text="Choose when reminders may run. Nothing is saved until you select Save schedule." Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,4,0,0" /></StackPanel>

    <Border BorderBrush="{DynamicResource ErrorBrush}" Background="{DynamicResource SurfaceBrush}"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource PhaseNotice}"><Style.Triggers><DataTrigger Binding="{Binding Configuration.HasScheduleError}" Value="True"><Setter Property="Visibility" Value="Visible" /><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Configuration.ScheduleError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Assertive" /></Border>
    <Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource PhaseNotice}"><Style.Triggers><DataTrigger Binding="{Binding Configuration.HasScheduleNotice}" Value="True"><Setter Property="Visibility" Value="Visible" /><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Configuration.ScheduleNotice}" Foreground="{DynamicResource SuccessBrush}" automation:AutomationProperties.LiveSetting="Polite" /></Border>

    <Grid x:Name="ScheduleColumns"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
      <StackPanel>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Reminder schedule" Style="{StaticResource SectionTitleText}" /><TextBlock Text="Allow Waterline to remind you during selected hours." Style="{StaticResource SecondaryText}" Margin="0,3,0,0" /></StackPanel><ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" IsChecked="{Binding Configuration.ScheduleRemindersEnabled, Mode=TwoWay}" automation:AutomationProperties.Name="Reminders enabled" /></Grid>
          <Grid Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Start time" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Configuration.ScheduleStart, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="Reminder schedule start time" /><TextBlock Text="Use your Windows time format." Style="{StaticResource SecondaryText}" Margin="0,6,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="End time" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Configuration.ScheduleEnd, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="Reminder schedule end time" /><TextBlock Text="Must be later on the same day." Style="{StaticResource SecondaryText}" Margin="0,6,0,0" /></StackPanel></Grid>
          <TextBlock Text="Reminder interval" Style="{StaticResource FieldLabel}" Margin="0,20,0,7" /><ComboBox ItemsSource="{Binding Configuration.ReminderIntervals}" SelectedItem="{Binding Configuration.ScheduleIntervalMinutes, Mode=TwoWay}" automation:AutomationProperties.Name="Reminder interval in minutes" />
        </StackPanel></Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Active days" Style="{StaticResource SectionTitleText}" /><TextBlock Text="Each day is explicit and keyboard accessible." Style="{StaticResource SecondaryText}" Margin="0,3,0,12" /><UniformGrid Columns="2"><CheckBox Content="Monday" IsChecked="{Binding Configuration.Monday, Mode=TwoWay}" automation:AutomationProperties.Name="Reminders on Monday" /><CheckBox Content="Tuesday" IsChecked="{Binding Configuration.Tuesday, Mode=TwoWay}" automation:AutomationProperties.Name="Reminders on Tuesday" /><CheckBox Content="Wednesday" IsChecked="{Binding Configuration.Wednesday, Mode=TwoWay}" automation:AutomationProperties.Name="Reminders on Wednesday" /><CheckBox Content="Thursday" IsChecked="{Binding Configuration.Thursday, Mode=TwoWay}" automation:AutomationProperties.Name="Reminders on Thursday" /><CheckBox Content="Friday" IsChecked="{Binding Configuration.Friday, Mode=TwoWay}" automation:AutomationProperties.Name="Reminders on Friday" /><CheckBox Content="Saturday" IsChecked="{Binding Configuration.Saturday, Mode=TwoWay}" automation:AutomationProperties.Name="Reminders on Saturday" /><CheckBox Content="Sunday" IsChecked="{Binding Configuration.Sunday, Mode=TwoWay}" automation:AutomationProperties.Name="Reminders on Sunday" /></UniformGrid></StackPanel></Border>
      </StackPanel>

      <StackPanel Grid.Column="2" x:Name="ScheduleRail">
        <Border Style="{StaticResource Card}" Background="{DynamicResource ActivityRailBrush}" Margin="0,0,0,16"><StackPanel><TextBlock Text="NEXT ELIGIBLE REMINDER" Style="{StaticResource MetadataText}" Foreground="{DynamicResource AquaBrush}" /><TextBlock Text="{Binding Configuration.SchedulePreview}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0" /><TextBlock Text="This preview updates with your draft and does not imply a notification has been scheduled yet." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel></Border>
        <Border Style="{StaticResource Card}" Background="{DynamicResource ActivityRailBrush}"><StackPanel><TextBlock Text="Draft changes" Style="{StaticResource SectionTitleText}" FontSize="18" /><TextBlock Text="Changes stay in this draft until saved." Style="{StaticResource SecondaryText}" Margin="0,4,0,14" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource QuietButton}" Content="Cancel" Click="Cancel_Click" IsEnabled="{Binding Configuration.HasScheduleChanges}" Margin="0,0,8,0" /><Button Style="{StaticResource PrimaryButton}" Content="Save schedule" Click="Save_Click" IsEnabled="{Binding Configuration.HasScheduleChanges}" /></StackPanel></StackPanel></Border>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>

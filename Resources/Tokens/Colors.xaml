<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
  <Color x:Key="CanvasColor">#FF030914</Color>
  <Color x:Key="CanvasRaisedColor">#FF05101D</Color>
  <Color x:Key="SurfaceColor">#FF071526</Color>
  <Color x:Key="SurfaceRaisedColor">#FF0B1D31</Color>
  <Color x:Key="SurfaceHoverColor">#FF102B43</Color>
  <Color x:Key="SurfacePressedColor">#FF0D2235</Color>
  <Color x:Key="ActivityRailColor">#FF061221</Color>
  <Color x:Key="BoundaryColor">#FF32677F</Color>
  <Color x:Key="DividerColor">#FF183447</Color>
  <Color x:Key="TextPrimaryColor">#FFF2F8FC</Color>
  <Color x:Key="TextSecondaryColor">#FFA9BAC8</Color>
  <Color x:Key="TextTertiaryColor">#FF7F95A6</Color>
  <Color x:Key="CyanColor">#FF43E4F7</Color>
  <Color x:Key="AquaColor">#FF68F2D0</Color>
  <Color x:Key="FocusColor">#FF7DEBFF</Color>
  <Color x:Key="SuccessColor">#FF67E1B0</Color>
  <Color x:Key="WarningColor">#FFFFC46B</Color>
  <Color x:Key="ErrorColor">#FFFF7D8C</Color>
  <Color x:Key="ScrimColor">#B8020710</Color>
  <Color x:Key="AccentTextColor">#FF021015</Color>
  <Color x:Key="AtmosphereColor">#1843E4F7</Color>
  <Color x:Key="AtmosphereLineColor">#18183F53</Color>
  <Color x:Key="SelectedSurfaceColor">#FF123444</Color>
  <Color x:Key="SelectedTextColor">#FFF2F8FC</Color>
  <Color x:Key="SelectedThumbColor">#FF43E4F7</Color>
  <Color x:Key="CloseHoverColor">#FFC42B42</Color>
  <Color x:Key="ClosePressedColor">#FF981E32</Color>
  <Color x:Key="ReservoirTopColor">#FF68F2D0</Color>
  <Color x:Key="ReservoirMiddleColor">#FF16BCEB</Color>
  <Color x:Key="ReservoirBottomColor">#FF0875C4</Color>

  <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
  <SolidColorBrush x:Key="CanvasRaisedBrush" Color="{StaticResource CanvasRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}" />
  <SolidColorBrush x:Key="ActivityRailBrush" Color="{StaticResource ActivityRailColor}" />
  <SolidColorBrush x:Key="BoundaryBrush" Color="{StaticResource BoundaryColor}" />
  <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
  <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
  <SolidColorBrush x:Key="AquaBrush" Color="{StaticResource AquaColor}" />
  <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
  <SolidColorBrush x:Key="ScrimBrush" Color="{StaticResource ScrimColor}" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
  <SolidColorBrush x:Key="AtmosphereBrush" Color="{StaticResource AtmosphereColor}" />
  <SolidColorBrush x:Key="AtmosphereLineBrush" Color="{StaticResource AtmosphereLineColor}" />
  <SolidColorBrush x:Key="SelectedSurfaceBrush" Color="{StaticResource SelectedSurfaceColor}" />
  <SolidColorBrush x:Key="SelectedTextBrush" Color="{StaticResource SelectedTextColor}" />
  <SolidColorBrush x:Key="SelectedThumbBrush" Color="{StaticResource SelectedThumbColor}" />
  <SolidColorBrush x:Key="CloseHoverBrush" Color="{StaticResource CloseHoverColor}" />
  <SolidColorBrush x:Key="ClosePressedBrush" Color="{StaticResource ClosePressedColor}" />
  <LinearGradientBrush x:Key="ReservoirBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{StaticResource ReservoirTopColor}" /><GradientStop Color="{StaticResource ReservoirMiddleColor}" Offset=".55" /><GradientStop Color="{StaticResource ReservoirBottomColor}" Offset="1" /></LinearGradientBrush>
  <system:Double x:Key="DialogShadowOpacity">0.55</system:Double>
  <system:Boolean x:Key="FloatingShadowEnabled">True</system:Boolean>

  <!-- Compatibility aliases while existing widget/dialog surfaces are migrated. -->
  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource DividerColor}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource SurfaceColor}" />
</ResourceDictionary>

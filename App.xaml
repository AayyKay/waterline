<Application x:Class="Waterline.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Tokens/Colors.xaml" />
        <ResourceDictionary Source="Resources/Tokens/Typography.xaml" />
        <ResourceDictionary Source="Resources/Tokens/Motion.xaml" />
        <ResourceDictionary Source="Resources/Icons/Icons.xaml" />
        <ResourceDictionary Source="Resources/Controls/Controls.xaml" />
        <ResourceDictionary Source="Resources/Surfaces/Surfaces.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>

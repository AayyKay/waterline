<Window x:Class="Waterline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Waterline" Width="1280" Height="860" MinWidth="900" MinHeight="650"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}" Icon="pack://application:,,,/Assets/waterline-app.ico"
        SizeChanged="Window_SizeChanged" StateChanged="Window_StateChanged" PreviewKeyDown="Window_PreviewKeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="IconPath" TargetType="Path">
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
      <Setter Property="StrokeThickness" Value="1.6" /><Setter Property="StrokeStartLineCap" Value="Round" /><Setter Property="StrokeEndLineCap" Value="Round" /><Setter Property="StrokeLineJoin" Value="Round" />
      <Setter Property="Stretch" Value="Uniform" /><Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyText}"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,7" /></Style>
    <Style x:Key="StateChip" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="9,4" /></Style>
    <Style x:Key="SampleCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Margin" Value="0,0,0,16" /></Style>
    <Storyboard x:Key="ShellEntrance">
      <DoubleAnimation Storyboard.TargetName="ShellRoot" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
      <DoubleAnimation Storyboard.TargetName="ShellTranslate" Storyboard.TargetProperty="Y" From="8" To="0" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
    </Storyboard>
  </Window.Resources>

  <Grid x:Name="ShellRoot" Opacity="0" Background="{DynamicResource CanvasBrush}">
    <Grid.RenderTransform><TranslateTransform x:Name="ShellTranslate" /></Grid.RenderTransform>
    <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="56" /><RowDefinition Height="*" /></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{DynamicResource CanvasRaisedBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
          <Viewbox Width="22" Height="22"><Path Data="{StaticResource IconWaterline}" Stroke="{DynamicResource CyanBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Viewbox>
          <TextBlock Text="Waterline" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="9,0,0,0" VerticalAlignment="Center" />
          <Border Style="{StaticResource StateChip}" Margin="12,0,0,0" Padding="7,2"><TextBlock Text="NATIVE PREVIEW" Style="{StaticResource MetadataText}" FontSize="10" Foreground="{DynamicResource AquaBrush}" /></Border>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" automation:AutomationProperties.Name="Minimize Waterline" ToolTip="Minimize">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconMinimize}" />
          </Button>
          <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" automation:AutomationProperties.Name="Maximize or restore Waterline" ToolTip="Maximize or restore">
            <Path x:Name="MaximizeGlyph" Style="{StaticResource IconPath}" Data="{StaticResource IconMaximize}" />
          </Button>
          <Button Style="{StaticResource CloseCaptionButton}" Click="WindowClose_Click" automation:AutomationProperties.Name="Close Waterline" ToolTip="Close">
            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconClose}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="24,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
          <Viewbox Width="28" Height="28"><Path Data="{StaticResource IconWaterline}" Stroke="{DynamicResource CyanBrush}" StrokeThickness="1.5" /></Viewbox>
          <TextBlock Text="waterline" FontSize="18" FontWeight="SemiBold" Margin="10,0,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
          <ToggleButton x:Name="TodayNav" Style="{StaticResource NavButton}" IsChecked="True" Click="Navigation_Click" Tag="Today" automation:AutomationProperties.Name="Today, selected">
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconToday}" /><TextBlock Text="Today" Margin="9,0,0,0" /></StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="InsightsNav" Style="{StaticResource NavButton}" Click="Navigation_Click" Tag="Insights" automation:AutomationProperties.Name="Insights">
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconInsights}" /><TextBlock Text="Insights" Margin="9,0,0,0" /></StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="GoalsNav" Style="{StaticResource NavButton}" Click="Navigation_Click" Tag="Goals" automation:AutomationProperties.Name="Goals">
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconGoals}" /><TextBlock Text="Goals" Margin="9,0,0,0" /></StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="ScheduleNav" Style="{StaticResource NavButton}" Click="Navigation_Click" Tag="Schedule" automation:AutomationProperties.Name="Schedule">
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconSchedule}" /><TextBlock Text="Schedule" Margin="9,0,0,0" /></StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="WidgetNav" Style="{StaticResource NavButton}" Click="Navigation_Click" Tag="Widget" automation:AutomationProperties.Name="Widget">
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconWidget}" /><TextBlock Text="Widget" Margin="9,0,0,0" /></StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="Navigation_Click" Tag="Settings" automation:AutomationProperties.Name="Settings">
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconSettings}" /><TextBlock Text="Settings" Margin="9,0,0,0" /></StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="MoreNav" Style="{StaticResource NavButton}" Visibility="Collapsed" Click="More_Click" automation:AutomationProperties.Name="More destinations">
            <StackPanel Orientation="Horizontal"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconMore}" /><TextBlock Text="More" Margin="9,0,0,0" /></StackPanel>
            <ToggleButton.ContextMenu>
              <ContextMenu x:Name="MoreMenu">
                <MenuItem Header="Widget" Click="WidgetMenu_Click" InputGestureText="Ctrl+5" />
                <MenuItem Header="Settings" Click="SettingsMenu_Click" InputGestureText="Ctrl+6" />
              </ContextMenu>
            </ToggleButton.ContextMenu>
          </ToggleButton>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Fill="{DynamicResource AquaBrush}" />
          <TextBlock Text="Local only" Style="{StaticResource SecondaryText}" Margin="8,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ClipToBounds="True">
      <Grid.Background><DynamicResource ResourceKey="CanvasBrush" /></Grid.Background>
      <Ellipse Width="600" Height="280" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-220,-190,0,0" Fill="{DynamicResource AtmosphereBrush}" IsHitTestVisible="False" />
      <Path Data="M-80,500 C240,390 470,590 840,470 S1320,390 1510,520" Stroke="{DynamicResource AtmosphereLineBrush}" StrokeThickness="1" IsHitTestVisible="False" />
      <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0">
        <StackPanel Margin="24,28,24,32">
          <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="PageEyebrow" Text="PHASE 3 · NATIVE SYSTEM" Style="{StaticResource MetadataText}" Foreground="{DynamicResource CyanBrush}" />
              <TextBlock x:Name="PageTitle" Text="Native component foundation" Style="{StaticResource PageTitleText}" Margin="0,5,0,0" />
              <TextBlock Text="Reusable WPF controls, clear interaction states, and a shell built for Windows." Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource StateChip}" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{DynamicResource AquaBrush}" Margin="0,0,7,0" /><TextBlock Text="DESIGN SYSTEM LIVE" Style="{StaticResource MetadataText}" Foreground="{DynamicResource AquaBrush}" /></StackPanel></Border>
          </Grid>

          <Grid x:Name="ComponentColumns">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="PrimaryColumn">
              <Border Style="{StaticResource SampleCard}">
                <StackPanel>
                  <TextBlock Text="Actions" Style="{StaticResource SectionTitleText}" />
                  <TextBlock Text="Rest, hover, press, keyboard focus, default, destructive, and disabled states share fixed geometry." Style="{StaticResource SecondaryText}" Margin="0,4,0,18" TextWrapping="Wrap" />
                  <WrapPanel>
                    <Button x:Name="PrimarySampleButton" Style="{StaticResource PrimaryButton}" Content="Log 12 oz" Margin="0,0,10,10" IsDefault="True" />
                    <Button x:Name="SecondarySampleButton" Content="Secondary" Margin="0,0,10,10" />
                    <Button Style="{StaticResource QuietButton}" Content="Quiet action" Margin="0,0,10,10" />
                    <Button Style="{StaticResource DestructiveButton}" Content="Remove entry" Margin="0,0,10,10" />
                    <Button Content="Unavailable" IsEnabled="False" Margin="0,0,10,10" />
                    <Button Style="{StaticResource IconButton}" Margin="0,0,10,10" ToolTip="More actions" automation:AutomationProperties.Name="More actions"><Path Style="{StaticResource IconPath}" Data="{StaticResource IconMore}" /></Button>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource SampleCard}">
                <StackPanel>
                  <TextBlock Text="Inputs and selection" Style="{StaticResource SectionTitleText}" />
                  <TextBlock Text="Every field keeps its boundary, focus indicator, label, and error message without shifting layout." Style="{StaticResource SecondaryText}" Margin="0,4,0,18" TextWrapping="Wrap" />
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Daily goal" Style="{StaticResource FieldLabel}" />
                      <TextBox Text="80" automation:AutomationProperties.Name="Daily goal in ounces" />
                      <TextBlock Text="Stored locally in ounces." Style="{StaticResource SecondaryText}" Margin="0,6,0,16" />
                      <TextBlock Text="Invalid amount" Style="{StaticResource FieldLabel}" />
                      <TextBox Text="700" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="2" automation:AutomationProperties.Name="Invalid amount sample" />
                      <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><Path Data="{StaticResource IconWarning}" Stroke="{DynamicResource ErrorBrush}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" /><TextBlock Text="Enter 0.1–64 oz." Style="{StaticResource SecondaryText}" Foreground="{DynamicResource ErrorBrush}" Margin="6,0,0,0" /></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Reminder interval" Style="{StaticResource FieldLabel}" />
                      <ComboBox SelectedIndex="2" automation:AutomationProperties.Name="Reminder interval"><ComboBoxItem Content="30 minutes" /><ComboBoxItem Content="45 minutes" /><ComboBoxItem Content="1 hour" /><ComboBoxItem Content="90 minutes" /></ComboBox>
                      <CheckBox Content="Weekdays only" IsChecked="True" Margin="0,14,0,0" />
                      <CheckBox Content="Mixed selection" IsThreeState="True" IsChecked="{x:Null}" Margin="0,2,0,0" />
                      <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Gentle reminders" Style="{StaticResource BodyText}" VerticalAlignment="Center" /><ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" IsChecked="True" automation:AutomationProperties.Name="Gentle reminders" /></Grid>
                      <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Disabled setting" Style="{StaticResource BodyText}" VerticalAlignment="Center" /><ToggleButton Grid.Column="1" Style="{StaticResource SwitchToggle}" IsEnabled="False" /></Grid>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource SampleCard}">
                <StackPanel>
                  <TextBlock Text="Lists, progress, and scrolling" Style="{StaticResource SectionTitleText}" />
                  <TextBlock Text="Selection combines surface, text, and focus treatment. The scrollbar provides a 12-pixel interaction channel." Style="{StaticResource SecondaryText}" Margin="0,4,0,15" TextWrapping="Wrap" />
                  <ProgressBar Value="58" Maximum="100" Margin="0,0,0,14" automation:AutomationProperties.Name="58 percent hydration progress" />
                  <ListBox SelectedIndex="1" Height="126" automation:AutomationProperties.Name="Component state list">
                    <ListBoxItem Content="Empty day · no fabricated activity" />
                    <ListBoxItem Content="Tuesday · 46 oz · selected" />
                    <ListBoxItem Content="Wednesday · 80 oz · goal complete" />
                    <ListBoxItem Content="Unavailable item" IsEnabled="False" />
                  </ListBox>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="ActivityRail" Grid.Column="2">
              <Border Style="{StaticResource SampleCard}" Background="{DynamicResource ActivityRailBrush}">
                <StackPanel>
                  <TextBlock Text="Interaction states" Style="{StaticResource SectionTitleText}" />
                  <TextBlock Text="Use Tab and Shift+Tab to inspect visible focus. Ctrl+1–6 changes destinations." Style="{StaticResource SecondaryText}" Margin="0,4,0,16" TextWrapping="Wrap" />
                  <WrapPanel>
                    <Border Style="{StaticResource StateChip}" Margin="0,0,6,6"><TextBlock Text="REST" Style="{StaticResource MetadataText}" /></Border>
                    <Border Style="{StaticResource StateChip}" Margin="0,0,6,6" BorderBrush="{DynamicResource FocusBrush}"><TextBlock Text="FOCUS" Style="{StaticResource MetadataText}" Foreground="{DynamicResource FocusBrush}" /></Border>
                    <Border Style="{StaticResource StateChip}" Margin="0,0,6,6" BorderBrush="{DynamicResource SuccessBrush}"><TextBlock Text="SUCCESS" Style="{StaticResource MetadataText}" Foreground="{DynamicResource SuccessBrush}" /></Border>
                    <Border Style="{StaticResource StateChip}" Margin="0,0,6,6" BorderBrush="{DynamicResource ErrorBrush}"><TextBlock Text="ERROR" Style="{StaticResource MetadataText}" Foreground="{DynamicResource ErrorBrush}" /></Border>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource SampleCard}" Background="{DynamicResource ActivityRailBrush}">
                <StackPanel>
                  <TextBlock Text="Menus and tooltips" Style="{StaticResource SectionTitleText}" />
                  <TextBlock Text="Opaque floating surfaces remain readable over atmosphere." Style="{StaticResource SecondaryText}" Margin="0,4,0,14" TextWrapping="Wrap" />
                  <Button x:Name="MenuSampleButton" Content="Open sample menu" HorizontalAlignment="Stretch" Click="SampleMenu_Click">
                    <Button.ContextMenu><ContextMenu x:Name="SampleMenu"><MenuItem Header="Log water" InputGestureText="Ctrl+L" /><MenuItem Header="Show widget" IsCheckable="True" IsChecked="True" /><Separator /><MenuItem Header="Unavailable command" IsEnabled="False" /></ContextMenu></Button.ContextMenu>
                  </Button>
                  <Button Style="{StaticResource QuietButton}" Content="Hover for guidance" ToolTip="Waterline keeps hydration data on this device." Margin="0,8,0,0" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource SampleCard}" Background="{DynamicResource ActivityRailBrush}">
                <StackPanel>
                  <TextBlock Text="Dialog surface" Style="{StaticResource SectionTitleText}" />
                  <TextBlock Text="Confirm routine" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,14,0,3" />
                  <TextBlock Text="Save the goal and reminder schedule on this PC?" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Style="{StaticResource QuietButton}" Content="Cancel" Margin="0,0,8,0" /><Button Content="Save" IsDefault="True" /></StackPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource SampleCard}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SuccessBrush}">
                <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconCheck}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="1.8" Width="17" Height="17" Stretch="Uniform" Margin="0,1,10,0" /><StackPanel><TextBlock Text="Changes saved" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" /><TextBlock Text="This persistent feedback remains readable without sound." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel></StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>

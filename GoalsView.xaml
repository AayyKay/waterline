<UserControl x:Class="Waterline.GoalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
  <StackPanel>
    <StackPanel Margin="0,0,0,22"><TextBlock Text="GOALS" Style="{StaticResource MetadataText}" Foreground="{DynamicResource CyanBrush}" /><TextBlock Text="Set your daily target" Style="{StaticResource PageTitleText}" Margin="0,5,0,0" /><TextBlock Text="Your goal guides progress and history comparisons. It does not rewrite past drink amounts." Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,4,0,0" /></StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="360" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Daily water goal" Style="{StaticResource SectionTitleText}" /><TextBlock Text="Choose a personal tracking target from 8 to 512 ounces." Style="{StaticResource SecondaryText}" Margin="0,3,0,18" /><TextBlock Text="Goal in ounces" FontWeight="SemiBold" Margin="0,0,0,7" /><Grid MaxWidth="320" HorizontalAlignment="Left"><TextBox Text="{Binding Configuration.GoalText, UpdateSourceTrigger=PropertyChanged}" FontSize="22" Padding="12,7,48,7" automation:AutomationProperties.Name="Daily goal in ounces" /><TextBlock Text="oz" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" IsHitTestVisible="False" /></Grid>
        <Border Margin="0,12,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Configuration.HasSettingsError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Configuration.SettingsError}" Foreground="{DynamicResource ErrorBrush}" automation:AutomationProperties.LiveSetting="Assertive" /></Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"><Button Style="{StaticResource QuietButton}" Content="Cancel" Click="Cancel_Click" IsEnabled="{Binding Configuration.HasSettingsChanges}" Margin="0,0,8,0" /><Button Style="{StaticResource PrimaryButton}" Content="Save goal" Click="Save_Click" IsEnabled="{Binding Configuration.HasSettingsChanges}" /></StackPanel></StackPanel></Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Background="{DynamicResource ActivityRailBrush}"><StackPanel><TextBlock Text="HOW IT’S USED" Style="{StaticResource MetadataText}" Foreground="{DynamicResource AquaBrush}" /><TextBlock Text="A guide, not a prescription" Style="{StaticResource SectionTitleText}" Margin="0,10,0,0" /><TextBlock Text="Waterline uses this target for today’s percentage, remaining amount, pace guidance, and seven-day completion markers." TextWrapping="Wrap" Margin="0,10,0,0" /><TextBlock Text="Hydration needs vary. Follow advice from a qualified health professional when you have medical questions." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,10,0,0" /></StackPanel></Border>
    </Grid>
  </StackPanel>
</UserControl>

<Window x:Class="Waterline.AmountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log water" Width="360" Height="250" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/Assets/waterline-app.ico" MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <Border CornerRadius="23" BorderBrush="#6685AEF0" BorderThickness="1" Padding="26">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF102550" /><GradientStop Color="#FF07142E" Offset="1" /></LinearGradientBrush></Border.Background>
    <Border.Effect><DropShadowEffect Color="#D000061C" BlurRadius="38" ShadowDepth="12" /></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid><TextBlock Text="CUSTOM DRINK" Foreground="{StaticResource CyanBrush}" FontSize="9" FontWeight="Bold" /><Button Style="{StaticResource IconButton}" Content="×" Width="32" Height="32" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" IsCancel="True" /></Grid>
      <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="How much water?" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,15" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="AmountBox" Style="{StaticResource WaterTextBox}" Text="10" FontSize="24" /><TextBlock Grid.Column="1" Text="oz" Foreground="{StaticResource MutedBrush}" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0" /></Grid></StackPanel>
      <Button Grid.Row="2" Style="{StaticResource PrimaryButton}" Content="Add water" Click="Add_Click" IsDefault="True" />
    </Grid>
  </Border>
</Window>

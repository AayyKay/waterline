<Window x:Class="Waterline.AmountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log a custom amount" Width="350" Height="245" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/Assets/waterline-app.png">
  <Border Style="{StaticResource Card}" Margin="18">
    <StackPanel>
      <TextBlock Text="CUSTOM DRINK" Foreground="{StaticResource CyanBrush}" FontSize="10" />
      <TextBlock Text="How much water?" FontSize="23" FontWeight="SemiBold" Margin="0,7,0,18" />
      <DockPanel>
        <TextBox x:Name="AmountBox" Text="10" FontSize="25" Padding="12,8" Background="#FF07152F" Foreground="White" BorderBrush="{StaticResource LineBrush}" />
        <TextBlock Text=" oz" FontSize="18" VerticalAlignment="Center" Margin="8,0,0,0" />
      </DockPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
        <Button Style="{StaticResource PrimaryButton}" Content="Add water" Click="Add_Click" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>

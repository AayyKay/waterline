<Window x:Class="Waterline.AmountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Log a custom amount" Width="400" Height="310" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/waterline-app.ico"
        Loaded="Window_Loaded">
  <Border Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource BoundaryBrush}" BorderThickness="1" CornerRadius="16" Padding="0" KeyboardNavigation.TabNavigation="Cycle">
    <Border.Effect><DropShadowEffect Color="#B0000000" BlurRadius="30" ShadowDepth="10" Opacity="{DynamicResource DialogShadowOpacity}" /></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" CornerRadius="16,16,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid Margin="16,0,8,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Viewbox Width="20" Height="20"><Path Data="{StaticResource IconWaterline}" Stroke="{DynamicResource CyanBrush}" StrokeThickness="1.5" /></Viewbox>
            <TextBlock Text="Log water" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Width="40" Height="40" IsCancel="True" ToolTip="Close" automation:AutomationProperties.Name="Close custom amount dialog">
            <Path Data="{StaticResource IconClose}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" />
          </Button>
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Margin="24,20,24,24">
        <TextBlock Text="Custom amount" Style="{StaticResource SectionTitleText}" />
        <TextBlock Text="Enter the water you want to add today." Style="{StaticResource SecondaryText}" Margin="0,3,0,16" />
        <TextBlock Text="Amount in ounces" FontWeight="SemiBold" Margin="0,0,0,7" />
        <Grid>
          <TextBox x:Name="AmountBox" Text="10" FontSize="18" Padding="12,7,46,7" automation:AutomationProperties.Name="Amount in ounces" TextChanged="AmountBox_TextChanged" />
          <TextBlock Text="oz" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" IsHitTestVisible="False" />
        </Grid>
        <StackPanel x:Name="ErrorPanel" Orientation="Horizontal" Margin="0,7,0,0" Visibility="Hidden">
          <Path Data="{StaticResource IconWarning}" Stroke="{DynamicResource ErrorBrush}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" />
          <TextBlock x:Name="ErrorText" Text="Enter an amount from 0.1 to 64 oz." Style="{StaticResource SecondaryText}" Foreground="{DynamicResource ErrorBrush}" Margin="6,0,0,0" automation:AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Button Grid.Column="1" Style="{StaticResource QuietButton}" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
          <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Add water" Click="Add_Click" IsDefault="True" />
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</Window>

<UserControl x:Class="Waterline.WidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
  <StackPanel>
    <TextBlock Text="WIDGET" Style="{StaticResource MetadataText}" Foreground="{DynamicResource CyanBrush}" />
    <TextBlock Text="Hydration within reach" Style="{StaticResource PageTitleText}" Margin="0,5,0,0" />
    <TextBlock Text="Keep progress and one-action logging above your other windows." Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,4,0,22" />
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
            <TextBlock Text="DESKTOP COMPANION" Style="{StaticResource MetadataText}" Foreground="{DynamicResource AquaBrush}" />
            <TextBlock Text="Open or focus the widget" Style="{StaticResource SectionTitleText}" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock Text="Only one widget exists. It stays above other windows, synchronizes instantly with Today, and remembers its nearest screen edge." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,7,0,18" />
            <Button Style="{StaticResource PrimaryButton}" Content="Open widget" Click="Open_Click" automation:AutomationProperties.Name="Open or focus Waterline widget" />
            <TextBlock Text="{Binding CurrentWidgetMode, StringFormat=Saved appearance: {0}}" Style="{StaticResource SecondaryText}" Margin="0,11,0,0" />
          </StackPanel>
          <Border Grid.Column="1" Width="188" Height="236" CornerRadius="18" Background="{DynamicResource CanvasRaisedBrush}" BorderBrush="{DynamicResource BoundaryBrush}" BorderThickness="1">
            <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal"><Viewbox Width="23" Height="23"><Path Data="{StaticResource IconWaterline}" Stroke="{DynamicResource CyanBrush}" StrokeThickness="1.6" /></Viewbox><TextBlock Text="waterline" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" /></StackPanel>
              <Grid Grid.Row="1" Width="104" Height="104"><Ellipse Stroke="{DynamicResource DividerBrush}" StrokeThickness="7" /><Path Data="M52,4 A48,48 0 1 1 12,78" Stroke="{DynamicResource CyanBrush}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" /><TextBlock Text="45%" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
              <Border Grid.Row="2" Background="{DynamicResource CyanBrush}" Height="38" CornerRadius="9"><TextBlock Text="Log 12 oz" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <StackPanel Grid.Column="2">
        <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Expanded" Style="{StaticResource SectionTitleText}" /><TextBlock Text="Progress, remaining amount, quick logging, custom logging, reminders, and pace." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Compact" Style="{StaticResource SectionTitleText}" /><TextBlock Text="A 104 × 168 progress companion with one keyboard-focusable expand action." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border>
      </StackPanel>
    </Grid>
  </StackPanel>
</UserControl>
